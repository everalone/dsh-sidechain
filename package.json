{
  "name": "@dsh-external/dsh-sidechain",
  "description": "DSH side-conversation plugin: /side and /btw start a side conversation in an ephemeral fork of the current session (Codex /side & /btw semantics).",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "cordis.patch.yml",
    "dsh.plugin.json"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "check": "pnpm run typecheck && pnpm run test && pnpm run build"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-agent": "*",
    "@deepseek-ai/dsh-commands": "*",
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/dsh-session": "*",
    "@deepseek-ai/dsh-subagent": "*",
    "@deepseek-ai/dsh-tools": "*",
    "cordis": "^4.0.0-rc.7",
    "schemastery": "*"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-agent": "link:../../../../../.dsh/source/current/packages/core/agent",
    "@deepseek-ai/dsh-commands": "link:../../../../../.dsh/source/current/packages/ui/commands",
    "@deepseek-ai/dsh-llm": "link:../../../../../.dsh/source/current/packages/llm/llm",
    "@deepseek-ai/dsh-session": "link:../../../../../.dsh/source/current/packages/core/session",
    "@deepseek-ai/dsh-subagent": "link:../../../../../.dsh/source/current/packages/subagent/subagent",
    "@deepseek-ai/dsh-tools": "link:../../../../../.dsh/source/current/packages/core/tools",
    "cordis": "link:../../../../../.dsh/source/current/vendor/cordis",
    "schemastery": "link:../../../../../.dsh/source/current/vendor/schemastery",
    "tsdown": "^0.22.2",
    "typescript": "^5.9.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.1"
  },
  "license": "BSD-3-Clause"
}
