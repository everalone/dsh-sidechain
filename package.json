{
  "name": "@dsh-external/dsh-sidechain",
  "description": "DSH side-conversation plugin: /side and /btw start a side conversation in an ephemeral fork of the current session (Codex /side & /btw semantics).",
  "version": "0.6.1",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "cordis.patch.yml",
    "dsh.plugin.json"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.client.json",
    "test": "vitest run",
    "check": "pnpm run typecheck && pnpm run test && pnpm run build"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-agent": "*",
    "@deepseek-ai/dsh-commands": "*",
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/dsh-session": "*",
    "@deepseek-ai/dsh-subagent": "*",
    "@deepseek-ai/dsh-tools": "*",
    "cordis": "^4.0.0-rc.7",
    "react": "^18.2.0",
    "schemastery": "*"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-agent": "link:../../.dsh/source/current/packages/core/agent",
    "@deepseek-ai/dsh-client-runtime": "link:../../.dsh/source/current/packages/client/runtime",
    "@deepseek-ai/dsh-client-ui-conversation": "link:../../.dsh/source/current/packages/client/ui-conversation",
    "@deepseek-ai/dsh-client-connection": "link:../../.dsh/source/current/packages/client/connection",
    "@deepseek-ai/dsh-client-locale": "link:../../.dsh/source/current/packages/client/locale",
    "@deepseek-ai/dsh-client-ui-primitives": "link:../../.dsh/source/current/packages/client/ui-primitives",
    "@deepseek-ai/dsh-client-ui-slots": "link:../../.dsh/source/current/packages/client/ui-slots",
    "@deepseek-ai/dsh-commands": "link:../../.dsh/source/current/packages/interaction/commands",
    "@deepseek-ai/dsh-host-apiproxy": "link:../../.dsh/source/current/packages/host/apiproxy",
    "@deepseek-ai/dsh-llm": "link:../../.dsh/source/current/packages/llm/llm",
    "@deepseek-ai/dsh-session": "link:../../.dsh/source/current/packages/core/session",
    "@deepseek-ai/dsh-subagent": "link:../../.dsh/source/current/packages/subagent/subagent",
    "@deepseek-ai/dsh-tools": "link:../../.dsh/source/current/packages/core/tools",
    "@types/react": "~18.3.1",
    "@types/react-dom": "^18.3.1",
    "cordis": "link:../../.dsh/source/current/vendor/cordis",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "schemastery": "link:../../.dsh/source/current/vendor/schemastery",
    "tsdown": "^0.22.2",
    "typescript": "^5.9.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.1",
    "@types/node": "^22.0.0"
  },
  "license": "BSD-3-Clause"
}
